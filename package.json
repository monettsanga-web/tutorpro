{
  "name": "tutorpro-english-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-age-pages.mjs && node scripts/build-pricing-page.mjs && node scripts/build-landing-pages.mjs && node scripts/build-legitimacy-page.mjs && node scripts/build-city-pages.mjs && node scripts/build-subject-pages.mjs && node scripts/build-sitemap.mjs && vite build && node scripts/prerender-home.mjs",
    "build:edgeone": "node scripts/sync-curriculum-images.mjs && node scripts/build-age-pages.mjs && node scripts/build-pricing-page.mjs && node scripts/build-landing-pages.mjs && node scripts/build-legitimacy-page.mjs && node scripts/build-city-pages.mjs && vite build && node scripts/prerender-home.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:core && npm run test:pdf && npm run test:sync && npm run test:render && npm run test:ice && npm run test:handshake && npm run test:sharing && npm run test:signalling && npm run test:roles && npm run test:presence && npm run test:media && npm run test:reach && npm run test:feedback && npm run test:upload && npm run test:status && npm run test:synchealth && npm run test:writepolicy && npm run test:chinavideo && npm run test:reviews && npm run test:fbmerge && npm run test:ptreviews && npm run test:sharereview && npm run test:carousel && npm run test:bookingpage && npm run test:subjects && npm run test:vercel && npm run test:directmsg",
    "test:core": "node scripts/test-core.mjs",
    "test:pdf": "node scripts/test-pdf-compression.mjs",
    "test:sync": "node scripts/test-dashboard-sync.mjs",
    "test:render": "node scripts/test-dashboard-render.mjs",
    "classroom:server": "node server/classroom-signaling.mjs",
    "desktop:dev": "concurrently -k \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "seo:automation": "node scripts/seo-automation.mjs",
    "test:ice": "node scripts/test-ice-servers.mjs",
    "test:handshake": "node scripts/test-handshake-recovery.mjs",
    "test:sharing": "node scripts/test-classroom-sharing.mjs",
    "test:signalling": "node scripts/test-signalling-delivery.mjs",
    "test:roles": "node scripts/test-classroom-roles.mjs",
    "test:presence": "node scripts/test-presence-count.mjs",
    "test:media": "node scripts/test-media-publish.mjs",
    "test:reach": "node scripts/test-announcement-reach.mjs",
    "test:feedback": "node scripts/test-feedback-sync.mjs",
    "test:upload": "node scripts/test-feedback-upload.mjs",
    "test:status": "node scripts/test-status-sync.mjs",
    "test:synchealth": "node scripts/test-sync-health.mjs",
    "test:writepolicy": "node scripts/test-booking-write-policy.mjs",
    "test:chinavideo": "node scripts/test-china-video.mjs",
    "test:reviews": "node scripts/test-public-reviews.mjs",
    "test:fbmerge": "node scripts/test-feedback-merge.mjs",
    "test:ptreviews": "node scripts/test-parent-teacher-reviews.mjs",
    "test:sharereview": "node scripts/test-review-share-prompt.mjs",
    "test:carousel": "node scripts/test-review-carousel.mjs",
    "verify:video": "node scripts/verify-video-selfhosted.mjs",
    "verify:carousel": "node scripts/verify-curriculum-carousel.mjs",
    "verify:heromobile": "node scripts/verify-hero-mobile.mjs",
    "verify:panda": "node scripts/verify-panda-companion.mjs",
    "verify:classroomoff": "node scripts/verify-classroom-disabled.mjs",
    "verify:dashoff": "node scripts/verify-dashboard-classroom-off.mjs",
    "measure:egress": "node scripts/measure-egress-home.mjs",
    "measure:egressdash": "node scripts/measure-egress-dashboard.mjs",
    "verify:dashsync": "node scripts/verify-dashboard-still-syncs.mjs",
    "test:bookingpage": "node scripts/test-booking-page-safety.mjs",
    "test:subjects": "node scripts/test-subjects.mjs",
    "verify:subjects": "node scripts/verify-subjects.mjs",
    "test:vercel": "node scripts/test-vercel-config.mjs",
    "test:directmsg": "node scripts/test-direct-messages.mjs",
    "verify:directmsg": "node scripts/verify-direct-messages.mjs",
    "verify:chatlayout": "node scripts/verify-support-chat-layout.mjs",
    "verify:portalnav": "node scripts/verify-portal-nav.mjs",
    "verify:inboundmail": "node scripts/verify-inbound-support-email.mjs",
    "verify:seo": "node scripts/verify-subject-seo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.5.0",
    "three": "0.180.0",
    "trtc-sdk-v5": "5.18.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "vite": "8.1.4",
    "wait-on": "^8.0.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "ph.tutorpro.classroom",
    "productName": "TutorPro English Classroom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
